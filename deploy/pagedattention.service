[Unit]
Description=PagedAttentionMetal Inference Server
Documentation=https://github.com/abderahmane-ai/PagedAttentionMetal
After=network.target
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pagedattention
Group=pagedattention
WorkingDirectory=/opt/pagedattention
ExecStart=/opt/pagedattention/PagedAttentionServer
Restart=on-failure
RestartSec=5
StartLimitInterval=60s
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitNPROC=32768
MemoryLimit=8G
CPUQuota=800%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pagedattention/logs /opt/pagedattention/models /opt/pagedattention/config
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Environment
Environment=SERVER_HOST=0.0.0.0
Environment=SERVER_PORT=8080
Environment=MAX_BATCH_SIZE=16
Environment=MAX_SEQUENCES=128
Environment=MAX_BLOCKS=2048
Environment=BLOCK_SIZE=16
Environment=LOG_LEVEL=info
Environment=RUST_LOG=info

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pagedattention-server

[Install]
WantedBy=multi-user.target